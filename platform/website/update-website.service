[Unit]
Description=Publish the public website from the repository
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
# A fixed copy outside the repository (platform/server/update-website.sh, installed by platform/server/harden.sh):
# a commit cannot change what runs here as root.
ExecStart=/usr/local/sbin/syriahc-update-website
PrivateTmp=no
ProtectHome=yes
NoNewPrivileges=yes
