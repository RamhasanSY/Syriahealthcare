# Copy to .env on the server and fill in. Never commit .env.

# Public address of the platform (DNS A record must point to this server).
APP_DOMAIN=app.syriahealthcare.com

# Long random values. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=
OTP_SECRET=
# Encrypts doctors' licence documents. Keep a copy somewhere safe and separate from the backups:
# without it, the document backups cannot be opened.
DOCUMENT_KEY=

# SMS gateway for sign-in codes. "http" posts JSON {to, message, sender} with a bearer token.
# Adapt src/sms.js if your provider uses a different format.
SMS_PROVIDER=http
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER=SyriaHealth

# Email for "forgot password", welcome messages and review decisions. With a STRATO mailbox
# (e.g. noreply@syriahealthcare.com): host smtp.strato.de, port 465, the full address as user.
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Syria Healthcare <noreply@syriahealthcare.com>
