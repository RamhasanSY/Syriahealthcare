# Copy to .env on the server and fill in. Never commit .env.

# Public address of the platform (DNS A record must point to this server).
APP_DOMAIN=app.syriahealthcare.com

# Long random values. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=
OTP_SECRET=

# SMS gateway for sign-in codes. "http" posts JSON {to, message, sender} with a bearer token.
# Adapt src/sms.js if your provider uses a different format.
SMS_PROVIDER=http
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER=SyriaHealth
